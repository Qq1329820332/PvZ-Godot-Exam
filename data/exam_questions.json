      "type": "choice",
      "question": "极坐标下，面积元 dσ = ?",
      "options": [
        "A. dr dθ",
        "B. r dr dθ",
        "C. r² dr dθ",
        "D. dr² dθ"
      ],
      "answer": "B",
      "explanation": "极坐标下面积元为 dσ = r dr dθ"
    },
    {
      "id": "Q_M6_003",
      "knowledge_id": "M6_K03",
      "difficulty": 4,
      "type": "choice",
      "question": "积分 ∫_0^1 dx ∫_0^x f dy 交换次序后为：",
      "options": [
        "A. ∫_0^1 dy ∫_0^y f dx",
        "B. ∫_0^1 dy ∫_y^1 f dx",
        "C. ∫_0^1 dy ∫_0^1 f dx",
        "D. ∫_0^x dy ∫_0^1 f dx"
      ],
      "answer": "B",
      "explanation": "原区域：0≤x≤1, 0≤y≤x。交换后：0≤y≤1, y≤x≤1。即∫_0^1 dy ∫_y^1 f dx"
