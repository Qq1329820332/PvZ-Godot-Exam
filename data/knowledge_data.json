      "name": "一元函数积分学及其应用",
      "short_name": "一元积分学",
      "score_range": "约39分",
      "difficulty": 3,
      "icon": "integral",
      "knowledge_points": [
        {
          "id": "M3_K01",
          "name": "原函数与不定积分的概念",
          "category": "concept",
          "difficulty": 2,
          "description": "F'(x)=f(x)则F(x)是原函数。∫f(x)dx=F(x)+C，C为任意常数。",
          "formula": "∫f(x)dx = F(x) + C",
          "keywords": [
            "原函数",
            "不定积分",
            "C"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K02",
          "name": "基本积分公式",
          "category": "formula",
          "difficulty": 1,
          "description": "∫x^α = x^(α+1)/(α+1)+C; ∫1/x = ln|x|+C; ∫e^x = e^x+C; ∫sinx = -cosx+C; ∫cosx = sinx+C; ∫sec²x = tanx+C",
          "formula": "详见基本积分表",
          "keywords": [
            "积分公式",
            "幂函数",
            "三角函数"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K03",
          "name": "第一换元法（凑微分法）",
          "category": "method",
          "difficulty": 3,
          "description": "∫f(φ(x))·φ'(x)dx = ∫f(u)du（令u=φ(x)）。关键是找到φ'(x)凑成du。",
          "formula": "∫f(φ(x))·φ'(x)dx = ∫f(u)du",
          "keywords": [
            "第一换元",
            "凑微分"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_substitution_flower"
        },
        {
          "id": "M3_K04",
          "name": "不定积分第二换元法",
          "category": "method",
          "difficulty": 4,
          "description": "令x=ψ(t)，dx=ψ'(t)dt。用于含根号积分：√(a²-x²)设x=asint，√(a²+x²)设x=atant。",
          "formula": "∫f(x)dx = ∫f(ψ(t))·ψ'(t)dt",
          "keywords": [
            "第二换元",
            "三角代换",
            "根号"
          ],
          "exam_frequency": "medium",
          "plant_ref": "plant_substitution_flower"
        },
        {
          "id": "M3_K05",
          "name": "分部积分法",
          "category": "method",
          "difficulty": 3,
          "description": "∫udv = uv - ∫vdu。选u顺序：反→对→幂→指→三（反对幂指三）。",
          "formula": "∫udv = uv - ∫vdu",
          "keywords": [
            "分部积分",
            "反对幂指三"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_lotus"
        },
        {
          "id": "M3_K06",
          "name": "定积分的概念与性质",
          "category": "concept",
          "difficulty": 2,
          "description": "∫_a^b f(x)dx = lim Σf(ξ_i)Δx_i。几何意义：曲边梯形面积（代数和）。",
          "formula": "∫_a^b f(x)dx = lim Σf(ξ_i)Δx_i",
          "keywords": [
            "定积分",
            "黎曼和",
            "面积"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K07",
          "name": "变上限积分函数",
          "category": "concept",
          "difficulty": 3,
          "description": "F(x)=∫_a^x f(t)dt，F'(x)=f(x)。推广：d/dx∫_{ψ}^{φ}f(t)dt = f(φ)φ' - f(ψ)ψ'。",
          "formula": "d/dx ∫_a^x f(t)dt = f(x)",
          "keywords": [
            "变上限积分",
            "变限求导"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K08",
          "name": "牛顿-莱布尼茨公式",
          "category": "theorem",
          "difficulty": 2,
          "description": "若F(x)是原函数，则∫_a^b f(x)dx = F(b)-F(a)。微积分基本定理。",
          "formula": "∫_a^b f(x)dx = F(b) - F(a)",
          "keywords": [
            "牛顿-莱布尼茨",
            "微积分基本定理"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K09",
          "name": "定积分的换元积分法",
          "category": "method",
          "difficulty": 3,
          "description": "x=φ(t)，∫_a^b f(x)dx = ∫_{α}^{β} f(φ(t))·φ'(t)dt。注意换元必须换限！",
          "formula": "∫_a^b f(x)dx = ∫_{α}^{β} f(φ(t))·φ'(t)dt",
          "keywords": [
            "定积分换元",
            "换限"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_substitution_flower"
        },
        {
          "id": "M3_K10",
          "name": "定积分的分部积分法",
          "category": "method",
          "difficulty": 3,
          "description": "∫_a^b udv = [uv]_a^b - ∫_a^b vdu。多了上下限代入项。",
          "formula": "∫_a^b udv = [uv]_a^b - ∫_a^b vdu",
          "keywords": [
            "定积分分部",
            "上下限"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_lotus"
        },
        {
          "id": "M3_K11",
          "name": "定积分求平面图形面积",
          "category": "method",
          "difficulty": 3,
          "description": "S=∫|f(x)-g(x)|dx。关键是画图确定积分限和被积函数。",
          "formula": "S = ∫_a^b |f(x)-g(x)|dx",
          "keywords": [
            "面积",
            "定积分应用"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        },
        {
          "id": "M3_K12",
          "name": "旋转体体积",
          "category": "method",
          "difficulty": 3,
          "description": "绕x轴：V=π∫f²(x)dx。绕y轴：V=2π∫xf(x)dx（柱壳法）。",
          "formula": "V_x = π∫_a^b f²(x)dx",
          "keywords": [
            "旋转体",
            "体积",
            "柱壳法"
          ],
          "exam_frequency": "high",
          "plant_ref": "plant_integral_mushroom"
        }
      ]
    },
